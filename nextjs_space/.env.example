PORT=3106
NEXTAUTH_URL=http://127.0.0.1:3106
NEXTAUTH_SECRET=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ABACUSAI_API_KEY=

# Keep Preview runtime execution disabled until Preview DATABASE_URL values are isolated.
MARKETING_RUNTIME_ENABLED=false

# Keep non-auth Preview API writes disabled until Preview DATABASE_URL values are isolated.
PREVIEW_WRITES_ENABLED=false

# Controlled internal-team account creation. Public /api/signup is disabled unless enabled and gated.
TEAM_SIGNUP_ENABLED=false
TEAM_SIGNUP_INVITE_CODE=

# Operator bootstrap: yarn bootstrap:operators
# Preferred names. Legacy fallback prefixes OPERATOR_ADMIN and OPERATOR_FIELD are still accepted.
OPERATOR_DOUGLAS_EMAIL=
OPERATOR_DOUGLAS_PASSWORD=
OPERATOR_DOUGLAS_NAME=
OPERATOR_RYAN_EMAIL=
OPERATOR_RYAN_PASSWORD=
OPERATOR_RYAN_NAME=

# Public lead assessment token signing. Falls back to NEXTAUTH_SECRET when unset.
LEAD_ASSESSMENT_TOKEN_SECRET=

# Database backups: yarn db:backup / yarn db:restore
POSTGRES_BACKUP_DIR=.floyd/backups/postgres
POSTGRES_RESTORE_FILE=

AGENT_API_URL=
APOLLO_API_KEY=
EXPLORIUM_API_KEY=
PINECONE_API_KEY=
PINECONE_PRIMARY_HOST=
MEMORY_NAMESPACE_PREFIX=legacy-legion
CRON_SECRET=
NOTIF_ID_DAILY_DIGEST=
NOTIFICATION_API_URL=
NOTIFICATION_API_KEY=
